{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/session-start.js",
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/before-read.js",
        "matcher": "Read",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/after-edit-remind.js",
        "matcher": "Write",
        "timeout": 10
      },
      {
        "command": "node .cursor/hooks/after-edit-remind.js",
        "matcher": "StrReplace",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/stop-version-check.js",
        "timeout": 10,
        "loop_limit": 1
      }
    ]
  }
}
